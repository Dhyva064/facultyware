<%#
  views/pj/dashboard.ejs
  Fitur 5 — Konten Dashboard Statistik untuk PJ
%>

<%
  // PROTEKSI DEFENSIVE — gunakan locals (objek EJS) agar aman dari TDZ
  const stats = locals.stats || {
    totalLaporan: 0,
    menunggu: 0,
    dalamPengerjaan: 0,
    selesaiBulanIni: 0,
    persen: { total: '0', menunggu: '0', pengerjaan: '0', selesai: '0' }
  };

  const topAset = locals.topAset || [];
%>

<div class="mb-7">
  <h1 class="text-2xl font-bold text-slate-900 leading-tight">Dashboard Statistik</h1>
  <p class="text-[15px] text-slate-500 mt-1">Ringkasan aktivitas maintenance peralatan FTI.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-5">
  
  <!-- Card 1 -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 flex flex-col transition-shadow hover:shadow-sm">
    <div class="flex justify-between items-start">
      <span class="text-[14px] font-medium text-slate-500">Total Laporan Masuk</span>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-blue-50 text-blue-600">
        <i data-lucide="file-text" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="text-[32px] font-bold text-slate-800 leading-none mt-1"><%= stats.totalLaporan %></div>
    <div class="text-[13px] font-medium flex items-center gap-1 mt-5 <%= stats.persen.total.startsWith('-') ? 'text-red-500' : 'text-emerald-500' %>">
      <strong><%= stats.persen.total %>%</strong>
      <span class="text-slate-400 font-normal">vs bulan lalu</span>
    </div>
  </div>

  <!-- Card 2 -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 flex flex-col transition-shadow hover:shadow-sm">
    <div class="flex justify-between items-start">
      <span class="text-[14px] font-medium text-slate-500">Menunggu Verifikasi</span>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-orange-50 text-orange-500">
        <i data-lucide="clock" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="text-[32px] font-bold text-slate-800 leading-none mt-1"><%= stats.menunggu %></div>
    <div class="text-[13px] font-medium flex items-center gap-1 mt-5 <%= stats.persen.menunggu.startsWith('-') ? 'text-red-500' : 'text-emerald-500' %>">
      <strong><%= stats.persen.menunggu %>%</strong>
      <span class="text-slate-400 font-normal">vs bulan lalu</span>
    </div>
  </div>

  <!-- Card 3 -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 flex flex-col transition-shadow hover:shadow-sm">
    <div class="flex justify-between items-start">
      <span class="text-[14px] font-medium text-slate-500">Dalam Pengerjaan</span>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-purple-50 text-purple-600">
        <i data-lucide="users" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="text-[32px] font-bold text-slate-800 leading-none mt-1"><%= stats.dalamPengerjaan %></div>
    <div class="text-[13px] font-medium flex items-center gap-1 mt-5 <%= stats.persen.pengerjaan.startsWith('-') ? 'text-red-500' : 'text-emerald-500' %>">
      <strong><%= stats.persen.pengerjaan %>%</strong>
      <span class="text-slate-400 font-normal">vs bulan lalu</span>
    </div>
  </div>

  <!-- Card 4 -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200 flex flex-col transition-shadow hover:shadow-sm">
    <div class="flex justify-between items-start">
      <span class="text-[14px] font-medium text-slate-500">Selesai (Bulan Ini)</span>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-emerald-50 text-emerald-600">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
      </div>
    </div>
    <div class="text-[32px] font-bold text-slate-800 leading-none mt-1"><%= stats.selesaiBulanIni %></div>
    <div class="text-[13px] font-medium flex items-center gap-1 mt-5 <%= stats.persen.selesai.startsWith('-') ? 'text-red-500' : 'text-emerald-500' %>">
      <strong><%= stats.persen.selesai %>%</strong>
      <span class="text-slate-400 font-normal">vs bulan lalu</span>
    </div>
  </div>

</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-[17px] font-bold text-slate-900">Tren Laporan Mingguan</h2>
    </div>
    <!-- Tambahkan inline style agar Chart.js tidak membaca tinggi 0px sebelum CDN selesai loading -->
    <div class="relative w-full" style="height: 320px;">
      <canvas id="chartTrenMingguan"></canvas>
    </div>
  </div>

  <div class="bg-white rounded-2xl p-6 border border-slate-200">
    <h2 class="text-[17px] font-bold text-slate-900 mb-5">Aset Sering Rusak (Top 5)</h2>

    <% if (topAset.length === 0) { %>
      <p class="text-slate-500 text-[14px] text-center py-8">Belum ada data laporan.</p>
    <% } else { %>
      <div class="flex flex-col gap-4">
        <% topAset.forEach(function(aset, idx) { %>
          <div class="flex items-center gap-4">
            <div class="w-8 h-8 rounded-full bg-red-50 text-red-500 text-[12px] font-bold flex items-center justify-center shrink-0">
              #<%= idx + 1 %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[14px] font-semibold text-slate-800 truncate"><%= aset.nama_aset %></div>
              <div class="text-[12px] text-slate-400 mt-0.5"><%= aset.kode_aset %></div>
            </div>
            <div class="text-[14px] font-bold text-slate-900 shrink-0">
              <%= aset.jumlah_rusak %> <span class="text-slate-500 font-normal text-[12px]">kali</span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

</div>

<script>
  (function() {
    // Gunakan JSON.parse dengan kutip agar IDE/Editor tidak error (Expression expected)
    const labels = JSON.parse('<%- locals.trendLabels || "[]" %>');
    const jumlah = JSON.parse('<%- locals.trendJumlah || "[]" %>');

    const ctx = document.getElementById('chartTrenMingguan');
    if (!ctx) return;

    // Create Gradient for chart
    const gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 320);
    gradient.addColorStop(0, 'rgba(46, 204, 113, 0.4)');
    gradient.addColorStop(1, 'rgba(46, 204, 113, 0.0)');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label          : 'Jumlah Laporan',
          data           : jumlah,
          borderColor    : '#2ECC71',
          backgroundColor: gradient,
          borderWidth    : 2.5,
          tension        : 0.4,
          fill           : true,
          pointBackgroundColor: '#fff',
          pointBorderColor: '#2ECC71',
          pointBorderWidth: 2,
          pointRadius         : 4,
          pointHoverRadius    : 6,
        }]
      },
      options: {
        responsive         : true,
        maintainAspectRatio: false,
        plugins: {
          legend : { display: false },
          tooltip: {
            backgroundColor: '#1E293B',
            padding: 10,
            titleFont: { family: 'Inter', size: 13 },
            bodyFont: { family: 'Inter', size: 13 },
            callbacks: { label: (c) => ` ${c.parsed.y} laporan` }
          }
        },
        scales: {
          x: {
            grid : { display: false, drawBorder: false },
            ticks: { font: { family: 'Inter', size: 12 }, color: '#94A3B8', padding: 10 }
          },
          y: {
            beginAtZero: true,
            border: { display: false },
            grid: { 
              color: '#F1F5F9',
              drawBorder: false,
            },
            ticks: { 
              stepSize: 2, 
              font: { family: 'Inter', size: 12 }, 
              color: '#94A3B8',
              padding: 15
            }
          }
        },
        interaction: {
          mode: 'index',
          intersect: false,
        },
      }
    });
  })();
</script>